# Pinned upstream sources for the self-contained Linux AppImage payload.
#
# This is the ONLY place versions live: .github/workflows/appimage.yml,
# .github/workflows/release.yml (via packaging/appimage/build-in-container.sh)
# and the local docker recipe all read this file. Bump here, then run the
# AppImage workflow.
#
# Every source is a sha256-pinned upstream release tarball (a git tag archive
# where upstream publishes no release tarball) and is verified before it is
# unpacked, so a moved or retagged upstream fails the build instead of
# silently shipping different code. Next to each tag pin the tag's commit is
# recorded as well, so a reviewer can see exactly which tree the archive is
# supposed to contain -- the sha256 is what actually enforces it.
#
# Source choice is driven by "builds with Ubuntu 22.04's gcc 11 / glibc 2.35",
# not by "newest version number": the AppImage's glibc floor is whatever the
# container has, and a newer upstream that needs a newer toolchain would
# raise it.

# --- mpv (libmpv only; the `mpv` CLI is not shipped) -----------------------
MPV_VERSION=v0.41.0
MPV_COMMIT=41f6a645068483470267271e1d09966ca3b9f413
MPV_URL=https://github.com/mpv-player/mpv/archive/refs/tags/v0.41.0.tar.gz
MPV_SHA256=ee21092a5ee427353392360929dc64645c54479aefdb5babc5cfbb5fad626209

# --- FFmpeg (LGPL build, shared libraries + the `ffmpeg` CLI) --------------
# 9.0.2 is the newest stable release on ffmpeg.org. mpv 0.41.0 is
# version-compatible with it (see README "Version choice"); if a future mpv
# pin stops building against a new FFmpeg major, pin the previous bugfix
# release of the older branch here (e.g. 8.1.3) rather than patching sources.
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e

# --- dav1d (AV1 decoder: libavcodec's AV1 decoder, used by mpv; the Rust
# `dav1d-sys` crate links it too for AVIF image decoding) -------------------
# The tag archive from GitHub rather than dav1d's canonical tarball on
# downloads.videolan.org: that host throttled to a few hundred bytes per second
# from a CI container (~30 min for 1 MB), and this is the same tree.
DAV1D_VERSION=1.5.4
DAV1D_URL=https://github.com/videolan/dav1d/archive/refs/tags/1.5.4.tar.gz
DAV1D_SHA256=a1d5b63d2d38ec9bd03acf643caa51fa22edd1e89c5a109c4807717216bbec07

# --- libass (unconditional mpv dependency; renders subtitle styling) ------
LIBASS_VERSION=0.17.5
LIBASS_COMMIT=4a05d8127f525943ebf45fdc6497c9e665947f0d
LIBASS_URL=https://github.com/libass/libass/releases/download/0.17.5/libass-0.17.5.tar.xz
LIBASS_SHA256=2dca25c0e0c837ddf00b52011b3f82cac1e4ddd3ad018227806b0c2288864acc

# --- zimg (mpv's high-quality software scaler for the software render API:
# ~7 ms vs ~66 ms per 4K frame; see AGENTS.md "Video pipeline") ------------
ZIMG_VERSION=release-3.0.6
ZIMG_URL=https://github.com/sekrit-twc/zimg/archive/refs/tags/release-3.0.6.tar.gz
ZIMG_SHA256=be89390f13a5c9b2388ce0f44a5e89364a20c1c57ce46d382b1fcc3967057577

# --- libplacebo (mpv 0.41's meson.build requires it unconditionally, even
# with gl/egl/vulkan disabled -- there is no -Dlibplacebo switch) ----------
LIBPLACEBO_VERSION=v7.360.1
LIBPLACEBO_COMMIT=cee9b076f2c63104ccfd497fa79c39a867293ec4
LIBPLACEBO_URL=https://github.com/haasn/libplacebo/archive/refs/tags/v7.360.1.tar.gz
LIBPLACEBO_SHA256=d05fdf90bea2f629eaa2d115e909fd356388ac639e54f77b87a018a6d76224bd

# --- wayland (mpv's Wayland backend requires wayland-client >= 1.21 and Ubuntu
# 22.04 ships 1.20; without it mpv would have to drop its Wayland backend, and
# with it VA-API hardware decoding on Wayland sessions) ---------------------
WAYLAND_VERSION=1.26.0
WAYLAND_COMMIT=87cc8a8728a923fc57938faa81ba0e74f34ecdc7
WAYLAND_URL=https://gitlab.freedesktop.org/wayland/wayland/-/archive/1.26.0/wayland-1.26.0.tar.gz
WAYLAND_SHA256=56b3a985cbfe17a926e3bcf037e4d374f44eaa33f3a4b364549dddf0d324cebc

# --- wayland-protocols (mpv's Wayland backend needs >= 1.31 for VA-API on
# Wayland; Ubuntu 22.04 ships 1.25) ---------------------------------------
WAYLAND_PROTOCOLS_VERSION=1.49
WAYLAND_PROTOCOLS_COMMIT=ee78491a237eaff9389a0ccf8680521d074407d3
WAYLAND_PROTOCOLS_URL=https://gitlab.freedesktop.org/wayland/wayland-protocols/-/archive/1.49/wayland-protocols-1.49.tar.gz
WAYLAND_PROTOCOLS_SHA256=8d94eee148db4d8111ccc0d4331de2f82d4b28c38e30eace9f052886480f7d86
