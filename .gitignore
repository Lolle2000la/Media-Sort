# Build artifacts
target/
**/target/

# Cargo.lock is for libraries and applications with binary deps; this is
# a binary application, so we do commit it.
# (See https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html)

# Legacy WPF v2.x reference copy (local only — never commit this, it is the
# pre-Rust C# codebase and must not be resurrected into the repo).
.Image-Sort-master/

# Local analysis notes from the Rust port; not part of the repository.
FEATURE_GAPS.md
AUTOMATION_ANALYSIS.md

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Website / Astro
website/node_modules/
website/dist/
website/.astro/
website/public/demos/

ui_test_config.toml

# Snapcraft build artifacts (local `snapcraft pack --destructive-mode`).
# Anchored to the repository root so an unrelated nested directory of the same
# name is not hidden.
/parts/
/stage/
/prime/
/dist-snap/
*.snap

# Flatpak build artifacts (local `flatpak-builder`; see flatpak/README.md).
/build-dir/
/flatpak-repo/
/.flatpak-builder/
/.flatpak-builder-state/
# The manifest rewritten to build the local checkout instead of the released
# tag; generated by .github/workflows/flatpak-build.yml (and by hand locally).
/flatpak/app.mediasort.MediaSort.ci.yml
